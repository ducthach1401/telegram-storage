COMPOSE_PROJECT_NAME=telegram-storage

APP_PORT=3000
SERVICE_NAME=telegram-storage

API_BASIC_AUTH_USER=admin
API_BASIC_AUTH_PASSWORD=changeme_api_basic_secret

DOWNLOAD_SHARE_SECRET=changeme_share_download_hmac_secret_min16chars
PUBLIC_APP_URL=http://localhost:3000

TELEGRAM_BOT_TOKEN=1234567890:AA_fakeReplaceWithBotFatherToken
TELEGRAM_STORAGE_CHAT_ID=-1001234567890
TELEGRAM_ALERT_CHAT_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=changeme_telegram_webhook_secret_token
TELEGRAM_SYNC_FOLDER_ID=root

MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=ap-southeast-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_BUCKET=telegram-storage
MINIO_FORCE_PATH_STYLE=true
MINIO_LIMIT_GB=20

FOLDER_ZIP_MAX_FILES=2000
FOLDER_ZIP_DOWNLOAD_TOKEN_TTL_SECONDS=3600
UPLOAD_TMP_DIR=tmp/uploads
UPLOAD_QUEUE_CONCURRENCY=3

SHARE_RATE_LIMIT_TTL_MS=60000
SHARE_RATE_LIMIT_MAX=60

REDIS_HOST=redis
REDIS_PORT=6379

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=telegram_storage
MYSQL_PASSWORD=changeme_app_password
MYSQL_DATABASE=telegram_storage

MYSQL_BACKUP_ENABLED=false
MYSQL_BACKUP_CRON=0 3 * * 0
MYSQL_BACKUP_FOLDER_NAME=backup

MYSQL_IMPORT_MAX_MB=512

TYPEORM_SYNCHRONIZE=true
