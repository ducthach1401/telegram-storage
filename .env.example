# Sao chép thành `.env` rồi thay token/chat/channel thật.

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=1234567890:AA_fakeReplaceWithBotFatherToken
TELEGRAM_STORAGE_CHAT_ID=-1001234567890

# HTTP API
HOST=0.0.0.0
PORT=3000
MAX_UPLOAD_MB=48

# MySQL (Docker Compose cùng stack: MYSQL_HOST=mysql)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=telegram_storage
MYSQL_PASSWORD=changeme_app_password
MYSQL_DATABASE=telegram_storage
MYSQL_ROOT_PASSWORD=changeme_root_password

# true = TypeORM tự đồng bộ schema (dev); production nên false sau khi có migration
TYPEORM_SYNCHRONIZE=true

# Chỉ dùng khi map cổng MySQL ra máy host (docker-compose.dev)
MYSQL_PUBLISH_PORT=3306
